# Local Spotify credentials for running scripts/ against a real account.
# Copy to `.env` (gitignored) and fill in your real values.
#
# Usage in your terminal, from the repo root:
#     source .env
#     python3 scripts/now_playing.py --dry-run
#
# `source .env` loads these into your current shell session — you only need
# to do it once per terminal window. Open a new terminal, source again.

export SPOTIFY_CLIENT_ID='paste-your-client-id-here'
export SPOTIFY_CLIENT_SECRET='paste-your-client-secret-here'
export SPOTIFY_REFRESH_TOKEN='paste-your-refresh-token-here'
